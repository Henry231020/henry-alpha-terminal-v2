# HENRY ALPHA TERMINAL V2 — configuration template
# Copy this file to .env on the private server; never commit real secrets.
PORT=3000
MAX_TOKENS=500
MAX_EVENTS=500
# Keep market polling conservative to avoid provider rate limits.
DEX_REFRESH_MS=60000
# Helius free-tier standard WebSocket + confirmed transaction lookups. Keep the key private.
HELIUS_API_KEY=
# PostgreSQL persistence for trade observations and alert history.
POSTGRES_DB=henryalpha
POSTGRES_USER=henryalpha
POSTGRES_PASSWORD=replace-with-64-hex-characters

# Optional simulation only. Disabled by default; no wallet or real orders are used.
# Enable only after choosing your own test parameters.
PAPER_TRADING_ENABLED=false
PAPER_STARTING_BALANCE_USD=
PAPER_POSITION_SIZE_USD=
PAPER_STOP_LOSS_PCT=
PAPER_TAKE_PROFIT_PCT=
PAPER_TRAILING_STOP_PCT=
PAPER_DAILY_LOSS_LIMIT_USD=
PAPER_MAX_OPEN_POSITIONS=
