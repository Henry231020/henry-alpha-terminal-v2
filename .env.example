# HENRY ALPHA TERMINAL V2 — configuration template
# Copy these variable names into Render Environment; never commit real secrets.
PORT=3000
MAX_TOKENS=500
MAX_EVENTS=500
# Keep market polling conservative to avoid provider rate limits.
DEX_REFRESH_MS=60000
# Set this in Render to your private Helius API key. Do not put the key in GitHub.
HELIUS_API_KEY=
# Optional persistent database URL. Configure a managed PostgreSQL provider before relying on persistence.
DATABASE_URL=
# Optional provider key for PumpPortal trade subscriptions; not needed for launch/migration discovery.
PUMPPORTAL_API_KEY=
